# =====================================================
# RAG 智能知识问答系统 环境配置
# 复制本文件为 .env 后按需修改
# =====================================================

# ---------- 安全 ----------
# 生产环境请更换为随机长字符串，可用命令生成: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-secret
TOKEN_EXPIRE_MINUTES=10080

# ---------- 大模型 LLM（OpenAI 兼容接口）----------
# 可用提供商（任选其一，填入对应的 key 与 base_url）：
#   OpenAI      https://api.openai.com/v1          gpt-4o-mini
#   DeepSeek    https://api.deepseek.com/v1        deepseek-chat
#   智谱GLM     https://open.bigmodel.cn/api/paas/v4  glm-4-flash
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   硅基流动    https://api.siliconflow.cn/v1      Qwen/Qwen2.5-7B-Instruct
# 离线演示（无需任何 key）：LLM_PROVIDER=echo 时，系统返回模拟答案，用于验证全流程
LLM_PROVIDER=api
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---------- 文本向量化 Embedding ----------
# provider 可选值：
#   api   -> 调用 OpenAI 兼容 embedding 接口（推荐，速度快）
#   local -> 使用本地 sentence-transformers 模型（需 pip install sentence-transformers）
#   hash  -> 离线演示用确定性哈希向量（无需任何依赖，仅用于流程验证，语义效果有限）
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=sk-xxxxxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 文档切分参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 检索参数 ----------
TOP_K=5
# 是否启用 BM25 混合检索（+1 以融合关键词匹配能力）
ENABLE_BM25=true

# ---------- 服务端口 ----------
PORT=8000
